# Base URL of the Squeekchain public API. The game calls GET {url}/v1/status.
# Leave empty to run on the demo wheel. Add ?demo to the page URL to force the demo wheel.
VITE_SQUEEK_API_URL=

# Free Reown (WalletConnect) project id from https://cloud.reown.com, for phone wallets and QR codes.
# Wallets installed in the browser (MetaMask, OKX, Rabby...) connect without it.
VITE_WALLETCONNECT_PROJECT_ID=

# Optional: your own Sepolia RPC URL (free from Alchemy, Infura or similar). Used first for reading NFTs.
# Public endpoints are used when it is empty.
VITE_SEPOLIA_RPC=
